    "@vercel/node": "^3.2.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "knip": "^6.44.1",
    "playwright": "~1.62.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.0"
  }
