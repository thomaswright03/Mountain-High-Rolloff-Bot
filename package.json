{
  "name": "mountain-high-rolloff-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test lib/*.test.ts api/*.test.ts mts-sync/*.test.ts",
    "rolloff:send": "tsx mts-sync/sendRollOffTexts.ts",
