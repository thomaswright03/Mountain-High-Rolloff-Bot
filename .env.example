# Anthropic (Claude) API key
ANTHROPIC_API_KEY=

# GoHighLevel Private Integration token for Mountain High's location (the same
# location and scopes the Kaizen lead responder uses)
GHL_API_TOKEN=
GHL_LOCATION_ID=RieLbIngPIigRY4OH2mG

# The GHL "Company" custom field's ID (not its merge-tag name)
GHL_COMPANY_FIELD_KEY=Jm9OoZ1JVeR2Xbs7LRAV

# A secret you invent. Put the same value in the GHL workflow's webhook URL as
# ?secret=... so random traffic can't hit /api/webhook.
WEBHOOK_SHARED_SECRET=

# "true" drafts and logs replies but never sends or writes to GHL. Keep it on
# until Mountain High has reviewed real drafts.
DRY_RUN=true

# Optional pause switch: a URL serving {"active": true|false}. Unset = always on.
KILLSWITCH_URL=

# MTS login for the "did they already book?" check before every scheduled text
MTS_EMAIL=
MTS_PASSWORD=
