# Anthropic (Claude) API key
ANTHROPIC_API_KEY=
# Optional. CLAUDE_MODEL_ID writes replies (default claude-sonnet-5); CLAUDE_CHEAP_MODEL_ID
# runs the hand-off check and booking-answer reading (default claude-haiku-5-5; set to Sonnet to roll back).
CLAUDE_CHEAP_MODEL_ID=

# GoHighLevel Private Integration token for Mountain High's location (the same
# location and scopes the Kaizen lead responder uses)
GHL_API_TOKEN=
GHL_LOCATION_ID=RieLbIngPIigRY4OH2mG

# The GHL "Company" custom field's ID (not its merge-tag name)
GHL_COMPANY_FIELD_KEY=Jm9OoZ1JVeR2Xbs7LRAV

# A secret you invent. Put the same value in the GHL workflow's webhook URL as
# ?secret=... so random traffic can't hit /api/webhook.
WEBHOOK_SHARED_SECRET=

# "true" drafts and logs replies but never sends or writes to GHL. Keep it on
# until Mountain High has reviewed real drafts.
DRY_RUN=true

# Optional pause switch: a URL serving {"active": true|false}. Unset = always on.
KILLSWITCH_URL=

# MTS login for the "did they already book?" check before every scheduled text
MTS_EMAIL=
MTS_PASSWORD=

# Where each booking signed by text is emailed: Mountain High's customer
# team. Until it's set, bookings go to the stand-in in lib/companies.ts and
# /admin shows a Warning.
ROLLOFF_BOOKING_EMAIL=

# Set automatically when a Vercel Blob store is connected (Storage tab).
# Status records, dashboard counts and replies parked during a pause are kept
# there, private.
BLOB_READ_WRITE_TOKEN=

# Roll-off dashboard (/dashboard). The password you sign in with, at least 12
# characters. Changing it signs everyone out.
DASHBOARD_PASSWORD=

# Status page (/admin/status.json): optional bearer token for monitoring,
# 16+ characters. /admin itself uses DASHBOARD_PASSWORD.
ADMIN_STATUS_TOKEN=
DEPLOYED_AT=
